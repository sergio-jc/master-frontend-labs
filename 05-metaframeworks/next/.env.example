# Copy to `.env.local` and adjust if needed.

# Base URL of the mock API server (../api-server)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Base URL used to build each house's image URL
NEXT_PUBLIC_IMAGE_URL=http://localhost:3001

# Hostname allow-listed for next/image (next.config.ts) — must match IMAGE_URL's host
IMAGES_DOMAIN=localhost
